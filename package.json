{
  "name": "market-intelligence-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node tools/next-dev.mjs",
    "prebuild": "node tools/fetch-brand.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --test tests/ui-console.test.mjs",
    "test:platform": "python tools/run_checks.py --phase 10 && python tools/e2e_sealed_scenario.py",
    "verify": "npm run typecheck && npm run test:ui && npm run build && npm run test:platform"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
